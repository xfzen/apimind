info (
	title:  "ECP HTTP API"
	desc:   "Enterprise Control Plane API"
	author: "ApiMind"
)

syntax = "v1"

import "apis/common.api"
import "apis/operation.api"
import "apis/enterprise.api"
import "apis/application.api"
import "apis/connector.api"
import "apis/identity.api"
import "apis/auth.api"
import "apis/access.api"

@server (
	group:  metaPublic
	prefix: /api/v1
)
service ecp {
	@doc "Service health"
	@handler Health
	get /meta/health returns (HealthResp)

	@doc "Build and contract version"
	@handler Version
	get /meta/version returns (VersionResp)
}

@server (
	group:      authPublic
	prefix:     /api/v1
	middleware: RateLimit
)
service ecp {
	@doc "Begin an OIDC login transaction"
	@handler AuthStart
	get /auth/start (AuthStartReq) returns (AuthStartResp)

	@doc "Complete an OIDC login transaction"
	@handler AuthCallback
	get /auth/callback (AuthCallbackReq) returns (SessionSummaryResp)
}

@server (
	group:      adminRead
	prefix:     /api/v1
	middleware: AdminSession
)
service ecp {
	@doc "Current admin session"
	@handler CurrentSession
	get /auth/session returns (SessionSummaryResp)

	@doc "List admin sessions"
	@handler ListSessions
	get /auth/sessions (SessionListReq) returns (SessionListResp)

	@doc "List direct group members"
	@handler ListDirectGroupMembers
	get /identity/groups/:id/members (ListGroupMembersReq) returns (GroupMembersResp)

	@doc "Get instance security controls"
	@handler GetSecurityConfig
	get /instances/:id/security (SecurityConfigReq) returns (SecurityConfigResp)
}

@server (
	group:      adminWrite
	prefix:     /api/v1
	middleware: AdminSession,CSRF,IdempotencyHeaders,RateLimit
)
service ecp {
	@doc "End the current admin session"
	@handler Logout
	post /auth/logout returns (Empty)

	@doc "Revoke an admin session"
	@handler RevokeSession
	post /auth/sessions/:id/revoke (RevokeSessionReq) returns (Empty)

	@doc "Register an application"
	@handler RegisterApplication
	post /applications (RegisterApplicationReq) returns (ApplicationResp)

	@doc "Register an application instance"
	@handler RegisterInstance
	post /applications/:id/instances (RegisterInstanceReq) returns (InstanceResp)

	@doc "Put a product manifest"
	@handler PutManifest
	put /applications/:id/manifest (PutManifestReq) returns (ManifestResp)

	@doc "Admit a verified external identity"
	@handler AdmitJIT
	post /identity/jit (AdmitJITReq) returns (PrincipalResp)

	@doc "Block a principal locally"
	@handler BlockPrincipal
	post /identity/principals/:id/block (BlockPrincipalReq) returns (LifecycleResp)

	@doc "Create an ECP-managed direct group"
	@handler CreateIdentityGroup
	post /identity/groups (CreateGroupReq) returns (GroupResp)

	@doc "Synchronize a directory-managed direct group"
	@handler SyncDirectoryGroup
	post /identity/groups/directory/:externalId/sync (SyncDirectoryGroupReq) returns (GroupResp)

	@doc "Add one direct member to an ECP-managed group"
	@handler AddDirectGroupMember
	post /identity/groups/:id/members (AddGroupMemberReq) returns (Empty)

	@doc "Put instance security controls"
	@handler PutSecurityConfig
	put /instances/:id/security (PutSecurityConfigReq) returns (SecurityConfigResp)

	@doc "Reconcile projected Casdoor policies"
	@handler ReconcilePolicies
	post /instances/:id/policies/reconcile (ReconcilePoliciesReq) returns (PolicyProjectionResp)
}

@server (
	group:      connectorMachine
	prefix:     /api/v1
	middleware: ConnectorMachine,IdempotencyHeaders,RateLimit
)
service ecp {
	@doc "Register a product connector"
	@handler RegisterConnector
	post /connectors/register (RegisterConnectorReq) returns (ConnectorResp)

	@doc "Exchange a one-time product login transaction"
	@handler ExchangeProductLogin
	post /connector/auth/exchange (ProductLoginExchangeReq) returns (ProductLoginExchangeResp)

	@doc "Authorize one product operation"
	@handler Authorize
	post /access/authorize (AuthorizeReq) returns (AuthorizationDecisionResp)

	@doc "Authorize a batch of product operations"
	@handler BatchAuthorize
	post /access/batch (BatchAuthorizeReq) returns (BatchAuthorizeResp)
}
