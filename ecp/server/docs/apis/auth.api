syntax = "v1"

type AuthStartReq {
	EnterpriseID          string `form:"enterprise_id"`
	OIDCClientID          string `form:"oidc_client_id"`
	ApplicationInstanceID string `form:"application_instance_id,optional"`
	Kind                  string `form:"kind"`
	RedirectURI           string `form:"redirect_uri"`
}
type AuthStartResp {
	TransactionID string `json:"transaction_id"`
	State         string `json:"state"`
	Nonce         string `json:"nonce"`
	CodeChallenge string `json:"code_challenge"`
	ExpiresAt     int64  `json:"expires_at"`
}
type AuthCallbackReq {
	State string `form:"state"`
	Code  string `form:"code"`
}
type SessionSummaryResp {
	ID                    string `json:"id"`
	EnterpriseID          string `json:"enterprise_id"`
	PrincipalID           string `json:"principal_id"`
	ApplicationInstanceID string `json:"application_instance_id,optional"`
	Kind                  string `json:"kind"`
	ExpiresAt             int64  `json:"expires_at"`
	Revoked               bool   `json:"revoked"`
}
type SessionListReq { EnterpriseID string `form:"enterprise_id"` }
type SessionListResp { Sessions []SessionSummaryResp `json:"sessions"` }
type RevokeSessionReq {
	SessionID    string `path:"id"`
	EnterpriseID string `json:"enterprise_id"`
}
type ProductLoginExchangeReq { Code string `json:"code"` }
type ProductLoginExchangeResp {
	SessionToken string `json:"session_token"`
	CSRFToken    string `json:"csrf_token"`
	ExpiresAt    int64  `json:"expires_at"`
}
