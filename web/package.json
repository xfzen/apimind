{
  "name": "@apimind/web",
  "version": "0.1.0",
  "private": true,
  "description": "ApiMind Web browser application",
  "scripts": {
    "dev-copy-icon": "cp -r static/iconfont ./",
    "prepare:plugins": "node scripts/generate-plugin-module.js",
    "dev:vite": "npm run dev-copy-icon && npm run prepare:plugins && vite",
    "dev:chrome-cdp": "node scripts/start-chrome-cdp.mjs",
    "dev-client": "npm run dev:vite",
    "dev": "npm run dev-client",
    "preview": "vite preview --port 4173",
    "start": "npm run preview",
    "lint": "node --check vite.config.mjs && node --check scripts/start-chrome-cdp.mjs && node --check scripts/check-repository-boundary.mjs && node --check tests/repository-boundary.test.mjs && node --check tests/build-output.test.mjs && node --check tests/container-config.test.mjs && node --check tests/migration/current-snapshot.test.mjs",
    "test": "ava",
    "test:phase3:policy": "node --test tests/typescript-phase-3-policy.test.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "build:vite": "NODE_ENV=production npm run prepare:plugins && vite build",
    "build": "npm run build:vite",
    "inventory:runtime": "node scripts/typescript/runtime-inventory.mjs --build",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test:browser": "playwright test",
    "smoke:dev": "node scripts/smoke/dev-server-smoke.mjs",
    "smoke:deps": "node scripts/smoke/dependency-smoke.mjs",
    "smoke:editor-module": "node scripts/smoke/editor-module-smoke.mjs",
    "smoke:schema-editor": "node scripts/smoke/schema-editor-contract-smoke.mjs",
    "smoke:container": "sh scripts/smoke/container-smoke.sh",
    "docs": "ydoc build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xfzen/apimind.git",
    "directory": "web"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@apimind/mockjs-safe": "file:vendor/mockjs-safe",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@toast-ui/editor": "^3.2.2",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-i18n": "^4.2.0",
    "axios": "^1.18.1",
    "codemirror": "^6.0.2",
    "compare-versions": "^3.4.0",
    "copy-to-clipboard": "^4.0.2",
    "crypto-js": "^4.2.0",
    "deep-extend": "^0.5.0",
    "deref": "^0.7.3",
    "dompurify": "3.4.13",
    "easy-json-schema": "0.0.2-beta",
    "generate-schema": "^2.6.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "immer": "^1.1.1",
    "js-base64": "^3.7.8",
    "json-schema-faker": "^0.6.2",
    "json-schema-ref-parser": "^9.0.9",
    "json5": "^2.2.3",
    "jsondiffpatch": "^0.7.6",
    "jsoneditor": "^10.4.3",
    "jsrsasign": "^11.1.3",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-table-of-contents": "^1.2.0",
    "md5": "^2.3.0",
    "moment": "^2.19.3",
    "qs": "^6.15.3",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sha.js": "^2.4.12",
    "sha1": "1.1.1",
    "swagger-client": "^3.37.7",
    "tslib": "1.8.0",
    "underscore": "^1.13.8",
    "url": "0.11.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.3",
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/register": "^7.29.3",
    "@babel/runtime": "^7.24.0",
    "@playwright/test": "1.62.1",
    "@types/core-decorators": "0.20.0",
    "@types/crypto-js": "4.2.2",
    "@types/md5": "2.3.6",
    "@types/node": "22.20.0",
    "@types/prop-types": "15.7.15",
    "@types/qs": "6.15.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@types/redux-promise": "0.5.32",
    "@types/underscore": "1.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "antd": "^6.4.3",
    "anujs": "^1.2.6",
    "assets-webpack-plugin": "^7.1.1",
    "ava": "^2.4.0",
    "babel-eslint": "^7.2.3",
    "babel-loader": "^9.1.3",
    "babel-plugin-import": "^1.13.8",
    "brace": "^0.10.0",
    "buffer": "^6.0.3",
    "compression-webpack-plugin": "^10.0.0",
    "conventional-changelog-cli": "^2.1.1",
    "copy-webpack-plugin": "^11.0.0",
    "core-decorators": "^0.17.0",
    "css-loader": "^6.10.0",
    "eslint": "^3.19.0",
    "eslint-plugin-import": "^2.2.0",
    "eslint-plugin-react": "^7.1.0",
    "ghooks": "^2.0.0",
    "less": "^4.2.0",
    "less-loader": "^11.1.0",
    "markdown-it-include": "^2.0.0",
    "mini-css-extract-plugin": "^2.9.0",
    "nodemon": "^1.11.0",
    "prop-types": "^15.5.10",
    "rc-queue-anim": "^1.2.0",
    "rc-scroll-anim": "^1.0.7",
    "rc-tween-one": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^5.3.4",
    "recharts": "^2.15.4",
    "redux": "^4.2.1",
    "redux-promise": "^0.5.3",
    "rewire": "^2.5.2",
    "sass-embedded": "^1.77.5",
    "sass-loader": "^13.3.3",
    "string-replace-webpack-plugin": "^0.1.3",
    "typescript": "5.9.3",
    "validate-commit-msg": "^2.12.2",
    "vite": "^5.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^6.1.3",
    "webpack-node-externals": "^3.0.0",
    "ydoc-plugin-img-view": "^1.0.1"
  },
  "config": {
    "ghooks": {
      "commit-msg": "validate-commit-msg"
    },
    "validate-commit-msg": {
      "types": [
        "feat",
        "fix",
        "docs",
        "test",
        "chore",
        "ci",
        "refactor",
        "opti"
      ],
      "warnOnFail": false,
      "maxSubjectLength": 100,
      "subjectPattern": ".+",
      "subjectPatternErrorMsg": "请输入message信息!",
      "helpMessage": "Commit message 格式错误， http://www.ruanyifeng.com/blog/2016/01/commit_message_change_log.html"
    }
  },
  "engines": {
    "node": ">= 22.0.0",
    "npm": ">= 10.0.0"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "loose": true
        }
      ],
      "@babel/preset-react"
    ],
    "plugins": [
      [
        "@babel/plugin-proposal-decorators",
        {
          "legacy": true
        }
      ],
      [
        "@babel/plugin-proposal-class-properties",
        {
          "loose": true
        }
      ],
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": true
        }
      ],
      [
        "import",
        {
          "libraryName": "antd"
        }
      ]
    ]
  },
  "ava": {
    "files": [
      "test/**/*.js",
      "!test/server/**/*.js"
    ],
    "require": [
      "./test/register-typescript.cjs",
      "@babel/register"
    ]
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "lodash": "4.18.1"
  }
}
